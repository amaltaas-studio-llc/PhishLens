{
  "name": "phishlens",
  "version": "0.11.0",
  "private": true,
  "description": "Explainable phishing, malware and social-engineering risk analysis for Gmail, as a Chrome MV3 extension.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/build.mjs --dev --watch",
    "harness": "node scripts/harness.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "clean": "node scripts/build.mjs --clean-only",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:prompts": "node scripts/export-semantic-eval.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
